#!/usr/bin/env bash
# ============================================================================
#  cyberos-install: copy the running CyberOS live system to a disk.
#
#  The installed machine ends up IDENTICAL to the live ISO (same packages,
#  same theme), minus the live-only bits (autologin, archiso initramfs hooks).
#
#  Usage (interactive):   sudo cyberos-install
#     -> choose "Erase whole disk" (automatic layout) or "Manual" (cfdisk, pick
#        root / EFI / home partitions; keeps other operating systems).
#
#  Unattended, erase:      sudo cyberos-install --disk /dev/nvme0n1 --erase --hostname lab-07 \
#                              --user student --password 'S3cret!' --tz Africa/Accra --yes
#  Unattended, alongside:  sudo cyberos-install --disk /dev/sda --alongside --password ... --yes
#                          (uses existing free space; keeps other OSes and their ESP)
#  Unattended, manual:     sudo cyberos-install --disk /dev/sda --root /dev/sda5 --efi /dev/sda1 \
#                              [--format-efi] [--home /dev/sda6 [--format-home]] --password ... --yes
#  Other options:          --root-password P  --fs ext4|btrfs  --swap <GiB|0>
#                          --encrypt   LUKS2 full-disk encryption on the root partition
#                                      (passphrase = line 3 of --password-stdin)
# ============================================================================

# Sourcing this file with CYBEROS_INSTALL_LIB_ONLY=1 defines the helpers without
# running the installer, so they can be tested on a host with no disks to lose.
# `set -u` is kept inside the guard too: it leaks into bats and breaks its
# internals when the file is sourced.
if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
  set -euo pipefail
fi

# ---------------------------------------------------------------- palette & styling
C_GREEN="\033[38;2;0;202;78m"
C_GOLD="\033[38;2;255;203;6m"
C_CYAN="\033[38;2;0;190;255m"
C_RED="\033[38;2;255;95;86m"
C_GRAY="\033[38;2;130;130;130m"
C_BOLD="\033[1m"
C_DIM="\033[2m"
C_RESET="\033[0m"

DISK="" MODE="" ROOTP="" EFIP="" HOMEP="" FORMAT_EFI=0 FORMAT_HOME=0
HOSTNAME_="cyberos" USER_="student" PASS="" ROOTPASS="" TZ_="UTC" FS="ext4" YES=0 SWAP_GB=4
ENCRYPT=0 LUKSPASS="" LUKS_UUID="" PASS_FROM_ARGV=0

usage() { sed -n '3,21p' "$0"; exit 1; }
die()   {
  printf "\n${C_RED}${C_BOLD}ERROR: %s${C_RESET}\n\n" "$*" >&2
  if [[ -t 0 && ${CYBEROS_INSTALL_LIB_ONLY:-0} -eq 0 && ${YES:-0} -eq 0 ]]; then
    read -rp "Press Enter to exit..." _ 2>/dev/null || true
  fi
  exit 1
}
msg()   { printf "\n${C_CYAN}${C_BOLD}==>${C_RESET} ${C_BOLD}%s${C_RESET}\n" "$*"; }

# restore_kernel <flavour> <bootmnt> <dest>
#
# archiso keeps the kernel on the ISO rather than in the airootfs, so the copied
# root has an empty /boot and mkinitcpio fails with "must be readable". The
# default kernel is on the boot medium; linux-lts is not, but its image survives
# inside the squashfs under /usr/lib/modules.
restore_kernel() {
  local flavour=$1 bootmnt=$2 dest=$3 src

  src="$bootmnt/arch/boot/x86_64/vmlinuz-$flavour"
  if [[ -f $src ]]; then
    install -Dm644 "$src" "$dest/boot/vmlinuz-$flavour"
    return 0
  fi

  # Fall back to the copy inside the squashfs. Match on the module directory
  # suffix so "linux" never picks up the -lts image and boots the wrong kernel.
  if [[ $flavour == linux ]]; then
    src=$(find "$dest/usr/lib/modules" -maxdepth 2 -name vmlinuz 2>/dev/null \
            | grep -vE '/[^/]*-(lts|hardened|zen|rt)/vmlinuz$' | head -1)
  else
    src=$(find "$dest/usr/lib/modules" -maxdepth 2 -name vmlinuz \
            -path "*${flavour#linux-}/vmlinuz" 2>/dev/null | head -1)
  fi
  if [[ -n $src && -f $src ]]; then
    install -Dm644 "$src" "$dest/boot/vmlinuz-$flavour"
    return 0
  fi

  printf 'no kernel image found for %s (looked on the boot medium and in %s/usr/lib/modules)\n' \
    "$flavour" "$dest" >&2
  return 1
}

# grub_safe_entries <root-uuid> -- the /etc/grub.d/40_custom body.
#
# GRUB's generated entries cannot carry an extra kernel argument, so the recovery
# entries are written explicitly with the root UUID the installer already knows.
grub_safe_entries() {
  local uuid=$1 extra=${2:-} root="root=UUID=$1"
  [[ -n $uuid ]] || { printf 'grub_safe_entries: no root UUID\n' >&2; return 1; }
  # On an encrypted install the root is the mapper, not the UUID, and the extra
  # fragment carries cryptdevice=. Without this the recovery entries would look
  # right and fail to boot -- worse than not having them.
  if [[ -n $extra ]]; then root="$extra"; fi
  cat <<ENTRIES
#!/bin/sh
exec tail -n +3 \$0
# Recovery entries. Do not remove: a student whose GPU driver fails has no other
# way back to a desktop, and one whose kernel regressed has no other way to boot.

menuentry 'CyberOS (safe graphics)' --class cyberos {
    search --no-floppy --fs-uuid --set=root $uuid
    linux /boot/vmlinuz-linux $root rw nomodeset cyberos.safegraphics=1
    initrd /boot/initramfs-linux.img
}

menuentry 'CyberOS (LTS kernel)' --class cyberos {
    search --no-floppy --fs-uuid --set=root $uuid
    linux /boot/vmlinuz-linux-lts $root rw
    initrd /boot/initramfs-linux-lts.img
}

menuentry 'CyberOS (LTS kernel, safe graphics)' --class cyberos {
    search --no-floppy --fs-uuid --set=root $uuid
    linux /boot/vmlinuz-linux-lts $root rw nomodeset cyberos.safegraphics=1
    initrd /boot/initramfs-linux-lts.img
}
ENTRIES
}

# firewall_rules -- the posture an installed CyberOS machine boots with.
#
# A machine running Metasploit, Docker and a packet capture on a campus network
# needs default-deny. Nothing is opened by default: a student who needs a
# listening service opens that port deliberately.
firewall_rules() {
  cat <<'RULES'
ufw default deny incoming
ufw default allow outgoing
ufw --force enable
RULES
}

# assert_no_sshd_in_live <airootfs-dir> -- regression guard.
#
# The live user has no password. archiso's own drop-in shipped PermitRootLogin
# yes and PasswordAuthentication yes; ours replaces it, but the real protection
# is that sshd never starts in the live session at all.
assert_no_sshd_in_live() {
  local root=$1 hits
  hits=$(find "$root/etc/systemd/system" -name 'sshd*' 2>/dev/null || true)
  if [[ -n $hits ]]; then
    printf 'sshd is enabled in the live image:\n%s\n' "$hits" >&2
    return 1
  fi
  return 0
}

# initramfs_flavour <hooks-line> -- "systemd" or "busybox".
#
# mkinitcpio 41 ships HOOKS=(base systemd ...) by default. A systemd initramfs
# never runs the busybox `encrypt` hook, so inserting it there produces an
# initrd that boots, times out waiting for /dev/mapper/cryptroot, and drops to
# an emergency shell with root locked. Seen on build 14. The hook AND the kernel
# parameters both depend on which family is in use.
initramfs_flavour() {
  if grep -qw systemd <<<"$1"; then echo systemd; else echo busybox; fi
}

# luks_hooks <hooks-line> -- insert the unlock hook in the only place it works.
#
# It must run after block (which provides the device) and before filesystems
# (which mounts it). A keyboard hook must already be present, or a student on a
# non-US layout cannot type the passphrase -- and an encrypted disk nobody can
# unlock has no recovery path at all, so that case refuses rather than guesses.
luks_hooks() {
  local hooks=$1 hook
  hook=$([[ $(initramfs_flavour "$hooks") == systemd ]] && echo sd-encrypt || echo encrypt)
  if ! grep -qw keyboard <<<"$hooks"; then
    printf 'HOOKS has no keyboard hook; refusing to encrypt a disk whose passphrase could not be typed\n' >&2
    return 1
  fi
  if grep -qwE 'encrypt|sd-encrypt' <<<"$hooks"; then
    printf '%s\n' "$hooks"
    return 0
  fi
  if ! grep -qw block <<<"$hooks"; then
    printf 'HOOKS has no block hook; cannot place %s\n' "$hook" >&2
    return 1
  fi
  printf '%s\n' "${hooks/block/block $hook}"
}

# luks_cmdline <luks-uuid> <mapper-name> <hooks-line> -- the kernel parameters.
#
# systemd's initrd reads rd.luks.name=; the busybox encrypt hook reads
# cryptdevice=. Neither understands the other's spelling.
luks_cmdline() {
  local uuid=$1 mapper=${2:-cryptroot} hooks=${3:-}
  [[ -n $uuid ]] || { printf 'luks_cmdline: no LUKS UUID\n' >&2; return 1; }
  if [[ $(initramfs_flavour "$hooks") == systemd ]]; then
    printf 'rd.luks.name=%s=%s root=/dev/mapper/%s\n' "$uuid" "$mapper" "$mapper"
  else
    printf 'cryptdevice=UUID=%s:%s root=/dev/mapper/%s\n' "$uuid" "$mapper" "$mapper"
  fi
}

# ---------------------------------------------------------------- helpers
get_live_medium() {
  local src parent
  src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null | cut -d'[' -f1 || true)
  if [[ -n $src ]]; then
    parent=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1 || true)
    if [[ -n $parent ]]; then
      echo "/dev/$parent"
      return
    fi
    echo "$src"
    return
  fi
}

# disk_has_mount <disk> -- true if <disk> itself, one of its partitions, or a
# dm-crypt/LUKS mapper device stacked on one of those partitions is currently
# mounted. Goes through lsblk's own device-dependency walk rather than
# grepping /proc/mounts by device path: a mapper device's mount source is
# /dev/mapper/<name>, never the partition path underneath it, so a raw
# regex against the partition's own name misses a previous *encrypted*
# CyberOS install left unlocked and mounted.
disk_has_mount() {
  lsblk -pnro MOUNTPOINT "$1" 2>/dev/null | grep -q .
}

# is_whole_disk <path> -- true if <path> is a whole disk, not a partition.
# The interactive wizard only ever offers whole disks and separately checks
# -b on a free-typed path (see the disk-selection loop above); the
# unattended `--disk` path had no such check at all before this, so a typo
# like --disk /dev/sda1 would run wipefs/sgdisk -Z against a partition.
is_whole_disk() {
  [[ $(lsblk -dno TYPE "$1" 2>/dev/null) == disk ]]
}

# A disk carrying a previous CyberOS install (recognizable CYBEROS/CYBEROS_EFI
# labels from the mkfs calls below) is exactly what this project's own
# udisks2 auto-mount picks up as soon as the live session starts. wipefs/
# sgdisk -Z then fail with a raw kernel I/O error, not a clear message, if
# any of the target disk's own partitions are still mounted -- swapoff -a
# alone only handles swap, not a mounted filesystem. Returns non-zero, with
# a message on stderr, if disk_has_mount still finds something mounted once
# every unmount attempt below has run: silently pressing on into wipefs was
# the original bug, not just the missing unmount call.
unmount_disk() {
  local disk=$1 p
  for p in $(lsblk -pnro NAME "$disk" 2>/dev/null | tail -n +2); do
    umount -R "$p" 2>/dev/null || true
  done
  if disk_has_mount "$disk"; then
    echo "unmount_disk: $disk still has a mounted partition after unmount attempts" >&2
    return 1
  fi
}

get_free_space_gib() {
  local disk=$1 first last
  if command -v sgdisk >/dev/null 2>&1; then
    first=$(sgdisk -F "$disk" 2>/dev/null || true)
    last=$(sgdisk -E "$disk" 2>/dev/null || true)
    if [[ -n $first && -n $last && $last -ge $first ]]; then
      echo $(( (last - first + 1) * 512 / 1024 / 1024 / 1024 ))
      return
    fi
  fi
  echo 0
}

detect_default_timezone() {
  local tz=""
  if [[ -f /etc/timezone ]]; then
    tz=$(cat /etc/timezone)
  elif [[ -h /etc/localtime ]]; then
    tz=$(readlink /etc/localtime | sed 's|.*/zoneinfo/||')
  elif command -v timedatectl >/dev/null 2>&1; then
    tz=$(timedatectl show -p Timezone --value 2>/dev/null || true)
  fi
  if [[ -n $tz && -f "/usr/share/zoneinfo/$tz" ]]; then
    echo "$tz"
  else
    echo "Africa/Accra"
  fi
}

# valid_username <name> -- the set useradd itself accepts.
#
# USER_ is later expanded into useradd/chpasswd inside the chroot heredoc; a
# name outside this set is refused up front rather than relying on the heredoc
# quoting alone to make it merely inert.
valid_username() {
  [[ $1 =~ ^[a-z_][a-z0-9_-]*$ ]]
}

# valid_luks_passphrase <pass> -- the interactive wizard enforces 8+ chars;
# unattended/CLI use (--encrypt --password-stdin) MUST too, since it is the
# only thing protecting the disk and a client-side-only check is not a check.
valid_luks_passphrase() {
  [[ ${#1} -ge 8 ]]
}

render_banner() {
  clear 2>/dev/null || true
  printf "${C_GREEN}${C_BOLD}"
  cat <<'BANNER'
   ____      _               ___  ____  
  / ___|   _| |__   ___ _ __/ _ \/ ___| 
 | |  | | | | '_ \ / _ \ '__| | | \___ \ 
 | |__| |_| | |_) |  __/ |  | |_| |___) |
  \____\__, |_.__/ \___|_|   \___/|____/ 
       |___/                             
BANNER
  printf "${C_RESET}"
  printf "${C_CYAN}  CyberOS Interactive Installer${C_RESET} ${C_DIM}(Arch Linux with Hyprland & Quickshell)${C_RESET}\n"
  printf "${C_GRAY}  ────────────────────────────────────────────────────────────────────────${C_RESET}\n\n"
}

# The GPT protective MBR's "legacy bootable" flag helps a BIOS machine boot a
# GPT disk, and is pointless under UEFI. Worse than pointless: some firmware
# reads a GPT disk flagged this way as a hybrid/legacy disk and refuses it in
# UEFI-only mode, so the machine reports "no bootable device" even though the
# ESP, the boot entry and the kernels are all perfectly in place. Reproduced on
# a Lenovo ThinkPad T480 (2026-09-01): clearing the flag was what finally made
# the installed system boot. Set it only when we are actually installing in
# BIOS mode.
pmbr_boot_wanted() { [[ ${UEFI:-0} -eq 0 ]]; }

# Single place that ever turns the flag on, so the guard cannot be bypassed by
# a later edit adding another call site.
apply_pmbr_boot() {
  local disk=$1
  pmbr_boot_wanted || return 0
  parted -s "$disk" disk_set pmbr_boot on 2>/dev/null || true
}

# Everything below this point touches disks. Stop here when sourced for tests.
if [[ -n ${CYBEROS_INSTALL_LIB_ONLY:-} ]]; then
  return 0 2>/dev/null || exit 0
fi

DRY_RUN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --disk) DISK=$2; shift 2;;      --hostname) HOSTNAME_=$2; shift 2;;
    --erase) MODE=erase; shift;;    --manual) MODE=manual; shift;;
    --alongside) MODE=alongside; shift;;
    --root) ROOTP=$2; MODE=manual; shift 2;;
    --efi) EFIP=$2; shift 2;;       --format-efi) FORMAT_EFI=1; shift;;
    --home) HOMEP=$2; shift 2;;     --format-home) FORMAT_HOME=1; shift;;
    --user) USER_=$2; shift 2;;     --password) PASS=$2; PASS_FROM_ARGV=1; shift 2;;
    --password-stdin) IFS= read -r PASS; IFS= read -r ROOTPASS || true; IFS= read -r LUKSPASS || true; shift;;
    --root-password) ROOTPASS=$2; shift 2;;
    --tz) TZ_=$2; shift 2;;         --fs) FS=$2; shift 2;;
    --swap) SWAP_GB=$2; shift 2;;   --yes|-y) YES=1; shift;;
    --encrypt) ENCRYPT=1; shift;;
    --dry-run|--preview) DRY_RUN=1; shift;;
    -h|--help) usage;; *) die "unknown option $1";;
  esac
done

if [[ $DRY_RUN -eq 0 ]]; then
  [[ $EUID -eq 0 ]]        || die "run as root (sudo cyberos-install)"
  [[ -d /run/archiso ]]    || die "this must be run from the CyberOS live ISO"
fi
[[ $FS == ext4 || $FS == btrfs ]] || die "--fs must be ext4 or btrfs"

UEFI=0; [[ -d /sys/firmware/efi/efivars ]] && UEFI=1
part() { if [[ $DISK == *nvme* || $DISK == *mmcblk* ]]; then echo "${DISK}p$1"; else echo "${DISK}$1"; fi; }
settle_fs() { sync; udevadm settle; blkid "$1" >/dev/null 2>&1 || true; }
show_parts() { echo; lsblk -pno NAME,SIZE,FSTYPE,PARTTYPENAME,LABEL,MOUNTPOINTS "$DISK"; echo; }

# ============================================================================
#  INTERACTIVE CLI WIZARD (Archinstall / Omarchy style)
# ============================================================================
if [[ $YES -eq 0 ]]; then
  render_banner
  printf "${C_DIM}  Detected Firmware Mode: %s${C_RESET}\n\n" "$([[ $UEFI -eq 1 ]] && echo "UEFI" || echo "Legacy BIOS")"

  # ------------------------------------------------------------ Step 1: Disk
  if [[ -z $DISK ]]; then
    printf "${C_GOLD}${C_BOLD}[Step 1/6] Select Target Disk${C_RESET}\n"
    live_med=$(get_live_medium)

    disks=()
    disk_labels=()
    while IFS= read -r line; do
      [[ -z $line ]] && continue
      dev=$(echo "$line" | awk '{print $1}')
      size=$(echo "$line" | awk '{print $2}')
      type=$(echo "$line" | awk '{print $3}')
      model=$(echo "$line" | awk '{$1=$2=$3=""; print $0}' | sed -e 's/^[[:space:]]*//')

      if [[ $type != "disk" ]] || [[ $dev =~ ^/dev/(zram|loop|ram|sr|fd) ]] || [[ $dev == "$live_med" ]]; then
        continue
      fi

      disks+=("$dev")
      disk_labels+=("$dev  (${size})  ${model:0:32}")
    done < <(lsblk -dnpo NAME,SIZE,TYPE,MODEL 2>/dev/null)

    if [[ ${#disks[@]} -eq 0 ]]; then
      die "No suitable target disks detected on this system."
    fi

    printf "${C_GRAY}  ┌──────────────────────────────────────────────────────────────────┐${C_RESET}\n"
    for i in "${!disks[@]}"; do
      printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}[%d]${C_RESET} %-59s ${C_GRAY}│${C_RESET}\n" "$((i+1))" "${disk_labels[$i]}"
    done
    printf "${C_GRAY}  └──────────────────────────────────────────────────────────────────┘${C_RESET}\n"

    while true; do
      read -rp "  Select disk number [1-${#disks[@]}] (default: 1): " choice
      choice=${choice:-1}
      if [[ "$choice" =~ ^[0-9]+$ ]] && [[ $choice -ge 1 ]] && [[ $choice -le ${#disks[@]} ]]; then
        DISK="${disks[$((choice-1))]}"
        break
      elif [[ -b "$choice" ]]; then
        DISK="$choice"
        break
      else
        printf "${C_RED}  Invalid selection. Please choose a number between 1 and %d.${C_RESET}\n" "${#disks[@]}"
      fi
    done
    printf "\n"
  fi
  [[ -b $DISK ]] || die "$DISK is not a block device"

  # ------------------------------------------------------------ Step 2: Mode
  if [[ -z $MODE ]]; then
    printf "${C_GOLD}${C_BOLD}[Step 2/6] Installation Type for %s${C_RESET}\n" "$DISK"
    printf "${C_GRAY}  ┌──────────────────────────────────────────────────────────────────┐${C_RESET}\n"
    printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}[1]${C_RESET} ${C_GREEN}Erase whole disk${C_RESET}    (Automatic layout: BIOS + EFI + root)   ${C_GRAY}│${C_RESET}\n"
    printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}[2]${C_RESET} ${C_CYAN}Install alongside${C_RESET}   (Use free unallocated space on disk)    ${C_GRAY}│${C_RESET}\n"
    printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}[3]${C_RESET} ${C_GOLD}Custom manual${C_RESET}       (cfdisk / pick partitions manually)     ${C_GRAY}│${C_RESET}\n"
    printf "${C_GRAY}  └──────────────────────────────────────────────────────────────────┘${C_RESET}\n"

    while true; do
      read -rp "  Choose installation type [1/2/3] (default: 1): " m
      m=${m:-1}
      case "$m" in
        1) MODE=erase; break;;
        2) MODE=alongside; break;;
        3) MODE=manual; break;;
        *) printf "${C_RED}  Please enter 1, 2, or 3.${C_RESET}\n";;
      esac
    done
    printf "\n"
  fi

  # Manual partitioning handler
  if [[ $MODE == manual ]]; then
    show_parts
    read -rp "  Open cfdisk to edit partition table on $DISK? [Y/n]: " x
    if [[ ${x:-Y} =~ ^[Yy] ]]; then
      printf "${C_DIM}  Tips: GPT disks need a 1M 'BIOS boot' partition and an EFI partition (>=300M, FAT32) for UEFI.${C_RESET}\n"
      read -rp "  Press Enter to open cfdisk..." _
      cfdisk "$DISK"; partprobe "$DISK" 2>/dev/null || true; udevadm settle
    fi
    show_parts
    while [[ -z $ROOTP || ! -b $ROOTP ]]; do read -rp "  Root (/) partition (will be FORMATTED as $FS): " ROOTP; done
    if [[ $UEFI -eq 1 ]]; then
      while [[ -z $EFIP || ! -b $EFIP ]]; do read -rp "  EFI System partition (e.g. ${DISK}1): " EFIP; done
      if blkid -o value -s TYPE "$EFIP" 2>/dev/null | grep -q vfat; then
        read -rp "  Format $EFIP? (say n to keep existing Windows/Linux EFI) [y/N]: " x; [[ $x =~ ^[Yy] ]] && FORMAT_EFI=1
      else FORMAT_EFI=1; fi
    else
      read -rp "  EFI System partition (optional on BIOS, Enter to skip): " EFIP
      [[ -n $EFIP && ! -b $EFIP ]] && die "$EFIP is not a partition"
      [[ -n $EFIP ]] && { read -rp "  Format $EFIP? [y/N]: " x; [[ $x =~ ^[Yy] ]] && FORMAT_EFI=1; }
    fi
    read -rp "  Separate /home partition (optional, Enter to skip): " HOMEP
    if [[ -n $HOMEP ]]; then
      [[ -b $HOMEP ]] || die "$HOMEP is not a partition"
      read -rp "  Format $HOMEP? (n keeps existing data) [y/N]: " x; [[ $x =~ ^[Yy] ]] && FORMAT_HOME=1
    fi
    printf "\n"
  fi

  # Alongside mode space check
  if [[ $MODE == alongside ]]; then
    MIN_GIB=25
    command -v sgdisk >/dev/null || die "sgdisk not found"
    [[ $(blkid -o value -s PTTYPE "$DISK") == gpt ]] || die "Installing alongside requires a GPT disk; $DISK is not GPT"

    FREE_START=$(sgdisk -F "$DISK") || die "cannot read free space on $DISK"
    FREE_END=$(sgdisk -E "$DISK")   || die "cannot read free space on $DISK"
    FREE_GIB=$(( (FREE_END - FREE_START + 1) * 512 / 1024 / 1024 / 1024 ))
    printf "  Largest free block on %s: ${C_BOLD}%d GiB${C_RESET}\n" "$DISK" "$FREE_GIB"
    [[ $FREE_GIB -ge $MIN_GIB ]] || die "Need at least ${MIN_GIB} GiB of unallocated space, found ${FREE_GIB} GiB."

    if [[ $UEFI -eq 1 ]]; then
      EFIP=$(lsblk -pnro NAME,PARTTYPE "$DISK" | awk '$2=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"{print $1; exit}')
      [[ -n $EFIP ]] || die "No EFI System Partition found on $DISK; cannot install alongside on UEFI"
      FORMAT_EFI=0
      printf "  ${C_DIM}Reusing existing EFI System Partition: %s${C_RESET}\n" "$EFIP"
    fi

    before=$(lsblk -pnro NAME "$DISK" | tail -n +2 | sort)
    sgdisk -n 0:0:0 -t 0:8304 -c 0:CyberOS "$DISK" >/dev/null || die "Failed to create partition in free space"
    partprobe "$DISK" 2>/dev/null || true; udevadm settle; sleep 1
    after=$(lsblk -pnro NAME "$DISK" | tail -n +2 | sort)
    ROOTP=$(comm -13 <(echo "$before") <(echo "$after") | head -1)
    [[ -b ${ROOTP:-/nonexistent} ]] || die "Could not identify the newly created partition"
    printf "  ${C_GREEN}Created %s for CyberOS root (/)${C_RESET}\n\n" "$ROOTP"
    MODE=manual
  fi

  # ------------------------------------------------------------ Step 3: Account
  printf "${C_GOLD}${C_BOLD}[Step 3/6] User Account & System Configuration${C_RESET}\n"
  read -rp "  Computer hostname [$HOSTNAME_]: " x; HOSTNAME_=${x:-$HOSTNAME_}
  while true; do
    read -rp "  Username [$USER_]: " x; USER_=${x:-$USER_}
    if valid_username "$USER_"; then
      break
    else
      printf "${C_RED}  Username must consist of lowercase letters, digits, '_' or '-'.${C_RESET}\n"
    fi
  done

  while true; do
    read -rsp "  Enter password for $USER_: " p1; echo
    if [[ -z $p1 ]]; then
      printf "${C_RED}  Password cannot be empty.${C_RESET}\n"
      continue
    fi
    read -rsp "  Confirm password for $USER_: " p2; echo
    if [[ "$p1" != "$p2" ]]; then
      printf "${C_RED}  Passwords do not match. Please try again.${C_RESET}\n"
      continue
    fi
    PASS="$p1"
    break
  done

  read -rsp "  Root password [Enter to use same as $USER_]: " rp; echo
  ROOTPASS=${rp:-$PASS}
  printf "\n"

  # ------------------------------------------------------------ Step 4: Timezone
  DEFAULT_TZ=$(detect_default_timezone)
  printf "${C_GOLD}${C_BOLD}[Step 4/6] Timezone & Localization${C_RESET}\n"
  while true; do
    read -rp "  System timezone [$DEFAULT_TZ]: " x; TZ_=${x:-$DEFAULT_TZ}
    if [[ -f "/usr/share/zoneinfo/$TZ_" ]]; then
      break
    else
      printf "${C_RED}  Unknown timezone '%s'. Example: Africa/Accra, Europe/London, America/New_York${C_RESET}\n" "$TZ_"
    fi
  done
  printf "\n"

  # ------------------------------------------------------------ Step 5: Options
  printf "${C_GOLD}${C_BOLD}[Step 5/6] Storage & Security Options${C_RESET}\n"
  while true; do
    read -rp "  Filesystem (ext4 / btrfs) [$FS]: " x; FS=${x:-$FS}
    if [[ $FS == ext4 || $FS == btrfs ]]; then
      break
    else
      printf "${C_RED}  Please specify either 'ext4' or 'btrfs'.${C_RESET}\n"
    fi
  done

  read -rp "  Swap file size in GiB (0 for none) [$SWAP_GB]: " x; SWAP_GB=${x:-$SWAP_GB}

  read -rp "  Encrypt disk with LUKS2 full-disk encryption? [y/N]: " enc
  if [[ ${enc:-n} =~ ^[Yy] ]]; then
    ENCRYPT=1
    while true; do
      read -rsp "  Enter LUKS encryption passphrase (min 8 chars): " luks1; echo
      if ! valid_luks_passphrase "$luks1"; then
        printf "${C_RED}  Passphrase must be at least 8 characters.${C_RESET}\n"
        continue
      fi
      read -rsp "  Confirm LUKS encryption passphrase: " luks2; echo
      if [[ "$luks1" != "$luks2" ]]; then
        printf "${C_RED}  Passphrases do not match. Please try again.${C_RESET}\n"
        continue
      fi
      LUKSPASS="$luks1"
      break
    done
  else
    ENCRYPT=0
  fi
  printf "\n"

  # ------------------------------------------------------------ Step 6: Confirmation
  render_banner
  printf "${C_GOLD}${C_BOLD}[Step 6/6] Review Installation Summary${C_RESET}\n"
  disk_info=$(lsblk -dno SIZE,MODEL "$DISK" 2>/dev/null || echo "")

  printf "${C_GRAY}  ┌──────────────────────────────────────────────────────────────────┐${C_RESET}\n"
  printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}%-16s${C_RESET}: %-46s ${C_GRAY}│${C_RESET}\n" "Target Disk" "$DISK ($disk_info)"
  printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}%-16s${C_RESET}: %-46s ${C_GRAY}│${C_RESET}\n" "Install Mode" "$([[ $MODE == erase ]] && echo "ERASE WHOLE DISK" || echo "Custom / Alongside")"
  printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}%-16s${C_RESET}: %-46s ${C_GRAY}│${C_RESET}\n" "Filesystem" "$FS (${SWAP_GB} GiB swap)"
  printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}%-16s${C_RESET}: %-46s ${C_GRAY}│${C_RESET}\n" "Disk Encryption" "$([[ $ENCRYPT -eq 1 ]] && echo "Enabled (LUKS2)" || echo "Disabled")"
  printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}%-16s${C_RESET}: %-46s ${C_GRAY}│${C_RESET}\n" "Computer Name" "$HOSTNAME_"
  printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}%-16s${C_RESET}: %-46s ${C_GRAY}│${C_RESET}\n" "User Account" "$USER_ (sudo / wheel)"
  printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}%-16s${C_RESET}: %-46s ${C_GRAY}│${C_RESET}\n" "Timezone" "$TZ_"
  printf "  ${C_GRAY}│${C_RESET} ${C_BOLD}%-16s${C_RESET}: %-46s ${C_GRAY}│${C_RESET}\n" "Firmware Mode" "$([[ $UEFI -eq 1 ]] && echo "UEFI" || echo "Legacy BIOS")"
  printf "${C_GRAY}  └──────────────────────────────────────────────────────────────────┘${C_RESET}\n\n"

  if [[ $MODE == erase ]]; then
    printf "  ${C_RED}${C_BOLD}WARNING: ALL DATA ON %s WILL BE PERMANENTLY ERASED!${C_RESET}\n" "$DISK"
    read -rp "  Type 'ERASE' or 'yes' to proceed: " confirm
    [[ "$confirm" == "ERASE" || "$confirm" == "yes" || "$confirm" == "YES" ]] || die "Installation cancelled by user."
  else
    read -rp "  Type 'INSTALL' or 'yes' to proceed: " confirm
    [[ "$confirm" == "INSTALL" || "$confirm" == "yes" || "$confirm" == "YES" ]] || die "Installation cancelled by user."
  fi
  printf "\n"
fi

# Validation for unattended runs
[[ -n $DISK ]] || die "--disk <device> is required"
is_whole_disk "$DISK" || die "$DISK is not a whole disk (got a partition or missing device)"
[[ -n $PASS ]] || die "--password or --password-stdin is required"
ROOTPASS=${ROOTPASS:-$PASS}
[[ -f /usr/share/zoneinfo/$TZ_ ]] || die "unknown timezone $TZ_"
[[ $FS == ext4 || $FS == btrfs ]] || die "filesystem must be ext4 or btrfs"
valid_username "$USER_" || die "--user must match [a-z_][a-z0-9_-]* (got: $USER_)"
if [[ $PASS_FROM_ARGV -eq 1 ]]; then
  echo "WARNING: --password puts the password in argv, readable via /proc/*/cmdline by any local user. Prefer --password-stdin." >&2
fi
if [[ $ENCRYPT -eq 1 && -n $LUKSPASS ]] && ! valid_luks_passphrase "$LUKSPASS"; then
  die "--encrypt passphrase must be at least 8 characters -- it is the only thing protecting the disk"
fi

if [[ $DRY_RUN -eq 0 ]]; then
  if [[ $MODE == manual ]]; then
    [[ -b ${ROOTP:-/nonexistent} ]] || die "--root <partition> is required for manual mode"
    [[ $UEFI -eq 0 || -b ${EFIP:-/nonexistent} ]] || die "--efi <partition> is required on UEFI systems"
    for p_ in $ROOTP $EFIP $HOMEP; do grep -q "^$p_ " /proc/mounts && die "$p_ is mounted -- unmount it first"; done
    [[ $ROOTP != "$EFIP" && $ROOTP != "$HOMEP" ]] || die "root/efi/home must be different partitions"
  else
    disk_has_mount "$DISK" && die "$DISK is mounted -- unmount it first"
  fi
fi

if [[ $DRY_RUN -eq 1 ]]; then
  printf "${C_GREEN}${C_BOLD}  ✔ [DRY RUN] Summary confirmed!${C_RESET}\n"
  printf "${C_DIM}  In a live session, this would partition %s, format as %s, copy files, and install GRUB.${C_RESET}\n\n" "$DISK" "$FS"
  printf "${C_CYAN}  Dry run completed successfully. No changes were made to your disks.${C_RESET}\n\n"
  exit 0
fi

# ============================================================================
#  INSTALLATION EXECUTION
# ============================================================================
swapoff -a 2>/dev/null || true
unmount_disk "$DISK" || die "$DISK still has a mounted partition after unmount attempts -- unmount it manually and retry"

# ---------------------------------------------------------------- Step 1: Partition
if [[ $MODE == erase ]]; then
  msg "[1/5] Partitioning $DISK (GPT: BIOS-boot 1M, EFI 1G, root rest)"
  wipefs -af "$DISK" >/dev/null
  sgdisk -Z "$DISK" >/dev/null
  sgdisk -n1:0:+1M   -t1:ef02 -c1:"BIOS boot" \
         -n2:0:+1G   -t2:ef00 -c2:"EFI" \
         -n3:0:0     -t3:8304 -c3:"CyberOS root" "$DISK" >/dev/null
  apply_pmbr_boot "$DISK"
  partprobe "$DISK"; udevadm settle; sleep 1
  EFIP=$(part 2); ROOTP=$(part 3); FORMAT_EFI=1; HOMEP=""
else
  if [[ $(blkid -o value -s PTTYPE "$DISK" 2>/dev/null) == gpt ]]; then
    apply_pmbr_boot "$DISK"
  fi
fi

# ---------------------------------------------------------------- Step 2: Encrypt
if [[ $ENCRYPT -eq 1 ]]; then
  [[ -n $LUKSPASS ]] || die "--encrypt needs a passphrase: supply it as line 3 of --password-stdin or interactively"
  command -v cryptsetup >/dev/null || die "cryptsetup not available"
  msg "[2/5] Encrypting $ROOTP (LUKS2)"
  printf '%s' "$LUKSPASS" | cryptsetup luksFormat --type luks2 --batch-mode "$ROOTP" - \
    || die "luksFormat failed on $ROOTP"
  LUKS_UUID=$(blkid -o value -s UUID "$ROOTP")
  [[ -n $LUKS_UUID ]] || die "no UUID on the LUKS container"
  printf '%s' "$LUKSPASS" | cryptsetup open "$ROOTP" cryptroot - \
    || die "could not open the LUKS container"
  ROOTP=/dev/mapper/cryptroot
fi

# ---------------------------------------------------------------- Step 3: Format & Mount
msg "[2/5] Formatting and mounting filesystems"
if [[ $FS == btrfs ]]; then
  mkfs.btrfs -f -L CYBEROS "$ROOTP" >/dev/null
  settle_fs "$ROOTP"
  mount -t btrfs "$ROOTP" /mnt; btrfs subvolume create /mnt/@ >/dev/null
  if [[ -z $HOMEP ]]; then btrfs subvolume create /mnt/@home >/dev/null; fi
  umount /mnt
  mount -t btrfs -o subvol=@,compress=zstd,noatime "$ROOTP" /mnt
  mkdir -p /mnt/home
  if [[ -z $HOMEP ]]; then mount -t btrfs -o subvol=@home,compress=zstd,noatime "$ROOTP" /mnt/home; fi
else
  mkfs.ext4 -qF -L CYBEROS "$ROOTP"
  settle_fs "$ROOTP"
  mount -t ext4 "$ROOTP" /mnt
  mkdir -p /mnt/home
fi

if [[ -n $HOMEP ]]; then
  if [[ $FORMAT_HOME -eq 1 ]]; then mkfs.ext4 -qF -L CYBEROS_HOME "$HOMEP"; settle_fs "$HOMEP"; fi
  mount "$HOMEP" /mnt/home
fi

if [[ -n $EFIP ]]; then
  if [[ $FORMAT_EFI -eq 1 ]]; then mkfs.fat -F32 -n CYBEROS_EFI "$EFIP" >/dev/null; settle_fs "$EFIP"; fi
  mkdir -p /mnt/boot/efi
  mount -t vfat "$EFIP" /mnt/boot/efi
fi

# ---------------------------------------------------------------- Step 4: Copy System
msg "[3/5] Copying CyberOS system files (this may take a few minutes)..."
rsync -aHAXx --info=progress2 --no-inc-recursive \
  --exclude={/dev/*,/proc/*,/sys/*,/tmp/*,/run/*,/mnt/*,/media/*,/lost+found,/boot/efi/*} \
  --exclude=/etc/mkinitcpio.conf.d/archiso.conf \
  --exclude=/etc/sddm.conf.d/zz-live-autologin.conf \
  --exclude=/etc/sudoers.d/20-live-student \
  --exclude=/etc/systemd/system/etc-pacman.d-gnupg.mount \
  --exclude=/etc/systemd/system/pacman-init.service \
  --exclude=/etc/systemd/system/multi-user.target.wants/pacman-init.service \
  --exclude=/etc/systemd/journald.conf.d/volatile-storage.conf \
  --exclude=/etc/systemd/logind.conf.d/do-not-suspend.conf \
  --exclude=/etc/systemd/system/sleep.target \
  --exclude=/etc/systemd/system/suspend.target \
  --exclude=/etc/systemd/system/hibernate.target \
  --exclude=/etc/systemd/system/hybrid-sleep.target \
  --exclude=/etc/systemd/system/suspend-then-hibernate.target \
  --exclude=/etc/systemd/resolved.conf.d/archiso.conf \
  --exclude=/etc/systemd/system-generators/systemd-gpt-auto-generator \
  --exclude=/etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook \
  --exclude=/etc/motd \
  --exclude=/root/customize_airootfs.sh \
  / /mnt/

mkdir -p /mnt/{dev,proc,sys,tmp,run,mnt,media}
chmod 1777 /mnt/tmp

# ---------------------------------------------------------------- Step 5: Configure
msg "[4/5] Configuring system, users and security"
echo "$HOSTNAME_" > /mnt/etc/hostname
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$HOSTNAME_" > /mnt/etc/hosts
rm -f /mnt/etc/resolv.conf; touch /mnt/etc/resolv.conf
printf 'CyberOS \\r (\\l)\n\n' > /mnt/etc/issue
cat > /mnt/etc/motd <<'MOTD'
  CyberOS, Cyber Department. Type `fastfetch` for system info.
MOTD

cat > /mnt/etc/mkinitcpio.d/linux.preset <<'PRESET'
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
PRESET

cat > /mnt/etc/mkinitcpio.d/linux-lts.preset <<'PRESET'
ALL_kver="/boot/vmlinuz-linux-lts"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux-lts.img"
fallback_image="/boot/initramfs-linux-lts-fallback.img"
fallback_options="-S autodetect"
PRESET

restore_kernel linux /run/archiso/bootmnt /mnt || die "linux kernel image not found"
if ! restore_kernel linux-lts /run/archiso/bootmnt /mnt; then
  echo "WARNING: no LTS kernel found; this system will have no fallback kernel"
  rm -f /mnt/etc/mkinitcpio.d/linux-lts.preset
fi

genfstab -U /mnt > /mnt/etc/fstab

# Swapfile
if [[ $SWAP_GB -gt 0 ]]; then
  if [[ $FS == btrfs ]]; then
    btrfs subvolume create /mnt/swap >/dev/null
    btrfs filesystem mkswapfile --size "${SWAP_GB}g" /mnt/swap/swapfile >/dev/null
    echo '/swap/swapfile none swap defaults 0 0' >> /mnt/etc/fstab
  else
    mkswap -U clear --size "${SWAP_GB}G" --file /mnt/swapfile >/dev/null
    echo '/swapfile none swap defaults 0 0' >> /mnt/etc/fstab
  fi
fi

# First boot service
cat > /mnt/etc/systemd/system/cyberos-firstboot.service <<'SERVICE'
[Unit]
Description=CyberOS first boot tasks
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/usr/local/bin/cyberos-firstboot
[Install]
WantedBy=multi-user.target
SERVICE

# Encryption configuration
if [[ $ENCRYPT -eq 1 ]]; then
  CUR=$(sed -nE 's/^HOOKS=\((.*)\)$/\1/p' /mnt/etc/mkinitcpio.conf)
  NEW=$(luks_hooks "$CUR") || die "cannot place encrypt hook in mkinitcpio.conf"
  sed -i -E "s|^HOOKS=\(.*\)$|HOOKS=($NEW)|" /mnt/etc/mkinitcpio.conf
  FRAG=$(luks_cmdline "$LUKS_UUID" cryptroot "$NEW") || die "cannot build LUKS kernel command line"
  sed -i -E "s|^GRUB_CMDLINE_LINUX=\"(.*)\"$|GRUB_CMDLINE_LINUX=\"\\1 $FRAG\"|" /mnt/etc/default/grub
  if grep -q '^#\?GRUB_ENABLE_CRYPTODISK=' /mnt/etc/default/grub; then
    sed -i -E 's|^#?GRUB_ENABLE_CRYPTODISK=.*|GRUB_ENABLE_CRYPTODISK=y|' /mnt/etc/default/grub
  else
    echo 'GRUB_ENABLE_CRYPTODISK=y' >> /mnt/etc/default/grub
  fi
fi

# Recovery entries
ROOT_UUID=$(blkid -o value -s UUID "$ROOTP")
if [[ -n $ROOT_UUID ]]; then
  SAFE_ROOT=""
  [[ $ENCRYPT -eq 1 ]] && SAFE_ROOT=$(luks_cmdline "$LUKS_UUID" cryptroot "$(sed -nE 's/^HOOKS=\((.*)\)$/\1/p' /mnt/etc/mkinitcpio.conf)")
  grub_safe_entries "$ROOT_UUID" "$SAFE_ROOT" > /mnt/etc/grub.d/40_custom
  chmod 755 /mnt/etc/grub.d/40_custom
else
  echo "WARNING: no UUID for $ROOTP; skipping recovery boot entries"
fi

msg "[5/5] Finalizing inside chroot & installing bootloader"
# The heredoc delimiter is QUOTED ('CH'): the outer shell (running as root on
# the live medium) must not expand $USER_/$PASS/$ROOTPASS/$TZ_/$DISK/$UEFI into
# this script's source text, or a value containing a quote, backtick or $(...)
# becomes shell syntax that runs inside the chroot. Tainted values cross into
# the chroot as real environment variables instead, via `env`, and are
# expanded safely at runtime by the chroot's own bash.
arch-chroot /mnt /usr/bin/env \
  TZ_="$TZ_" USER_="$USER_" PASS="$PASS" ROOTPASS="$ROOTPASS" DISK="$DISK" UEFI="$UEFI" \
  /bin/bash -e <<'CH'
ln -sf "/usr/share/zoneinfo/$TZ_" /etc/localtime
hwclock --systohc || true

# users
if [[ "$USER_" != "student" ]]; then
  useradd -m -G wheel,adm,uucp,audio,video,input,storage,vboxusers,wireshark -s /usr/bin/zsh "$USER_"
  cp -rT /etc/skel "/home/$USER_" && chown -R "$USER_:$USER_" "/home/$USER_"
  userdel -r student 2>/dev/null || true
fi
echo "$USER_:$PASS" | chpasswd
echo "root:$ROOTPASS" | chpasswd

# drop live-only pieces
pacman -Rns --noconfirm mkinitcpio-archiso >/dev/null 2>&1 || true
rm -rf /etc/mkinitcpio.conf.d/archiso.conf /etc/sddm.conf.d/zz-live-autologin.conf
rm -f /usr/share/applications/cyberos-install.desktop \
      /usr/local/bin/cyberos-install /usr/local/bin/cyberos-install-gui
sed -i '\#foot --app-id=cyberos-installer#d' /etc/skel/.config/hypr/hyprland.lua /home/*/.config/hypr/hyprland.lua 2>/dev/null || true
systemctl enable NetworkManager sddm bluetooth power-profiles-daemon cyberos-firstboot cyberos-arch-audit.timer >/dev/null 2>&1
systemctl disable ModemManager >/dev/null 2>&1 || true

# pacman keyring
pacman-key --init >/dev/null 2>&1
pacman-key --populate archlinux >/dev/null 2>&1

mkinitcpio -P

# Bootloader setup
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="CyberOS"/' /etc/default/grub
grep -q '^GRUB_TOP_LEVEL=' /etc/default/grub \
  && sed -i 's|^GRUB_TOP_LEVEL=.*|GRUB_TOP_LEVEL=/boot/vmlinuz-linux|' /etc/default/grub \
  || echo 'GRUB_TOP_LEVEL=/boot/vmlinuz-linux' >> /etc/default/grub
sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub

grub-install --target=i386-pc --recheck "$DISK" || echo "WARNING: BIOS grub-install failed (fine on UEFI-only machines)"
if mountpoint -q /boot/efi; then
  # The removable path (\EFI\BOOT\BOOTX64.EFI) is the last-resort fallback some
  # firmware uses when no NVRAM entry matches.
  grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=CyberOS --removable --no-nvram --recheck
  if [[ $UEFI -eq 1 ]]; then
    # This writes the firmware boot entry, and it is the step that fails on
    # real machines (full NVRAM, read-only efivars). It used to end in
    # `|| true`, so a failure here was invisible: the disk got its EFI
    # binaries, the firmware got no entry, and the installer still declared
    # success. A ThinkPad T480 shipped exactly that way on 2026-09-01.
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=CyberOS --recheck \
      || echo "WARNING: grub-install could not register the UEFI boot entry" >&2
    # Trust the firmware's own list, not grub-install's exit code -- it can
    # copy the binaries and still leave no entry behind.
    if ! efibootmgr 2>/dev/null | grep -qi 'CyberOS'; then
      : > /var/log/cyberos-no-efi-entry
    fi
  fi
fi
grub-mkconfig -o /boot/grub/grub.cfg
CH

# Read the marker before the filesystems go away.
NO_EFI_ENTRY=0
[[ -f /mnt/var/log/cyberos-no-efi-entry ]] && NO_EFI_ENTRY=1

msg "Unmounting target filesystems..."
sync; umount -R /mnt

printf "\n${C_GREEN}${C_BOLD}"
printf "  ┌──────────────────────────────────────────────────────────────────┐\n"
printf "  │                   INSTALLATION COMPLETE!                         │\n"
printf "  ├──────────────────────────────────────────────────────────────────┤\n"
printf "  │  CyberOS was successfully installed.                             │\n"
printf "  │                                                                  │\n"
printf "  │  Target Disk : %-49s │\n" "$DISK"
printf "  │  User        : %-49s │\n" "$USER_"
printf "  │  Hostname    : %-49s │\n" "$HOSTNAME_"
printf "  │                                                                  │\n"
printf "  │  Please remove your installation media before restarting.        │\n"
printf "  └──────────────────────────────────────────────────────────────────┘\n"
printf "${C_RESET}\n"

# A machine with no firmware boot entry will land on "no bootable device" at
# the next power-on. Say so here rather than letting the student find out.
if [[ $NO_EFI_ENTRY -eq 1 ]]; then
  printf "${C_RED}${C_BOLD}"
  printf "  ┌──────────────────────────────────────────────────────────────────┐\n"
  printf "  │  WARNING: no UEFI boot entry could be created                    │\n"
  printf "  ├──────────────────────────────────────────────────────────────────┤\n"
  printf "  │  CyberOS is installed, but this computer's firmware has no entry  │\n"
  printf "  │  pointing at it, so it may boot to \"no bootable device\".          │\n"
  printf "  │                                                                  │\n"
  printf "  │  Fix: boot the CyberOS USB again and run                         │\n"
  printf "  │       sudo cyberos-repair-boot                                   │\n"
  printf "  │                                                                  │\n"
  printf "  │  Or pick the drive manually from the firmware boot menu (F12 on  │\n"
  printf "  │  ThinkPads) and select CyberOS.                                  │\n"
  printf "  └──────────────────────────────────────────────────────────────────┘\n"
  printf "${C_RESET}\n"
fi

if [[ $YES -eq 0 ]]; then
  read -rp "  Reboot system now? [Y/n]: " reb
  if [[ ${reb:-Y} =~ ^[Yy] ]]; then
    printf "${C_CYAN}  Rebooting system...${C_RESET}\n"
    systemctl reboot
  fi
fi
